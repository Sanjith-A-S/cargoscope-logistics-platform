# Copy this file to .env and fill in the values before running locally.
# .env is gitignored — never commit real secrets.

# HMAC-SHA256 key for signing JWTs — generate a strong random string in production
AUTH_SECRET_KEY=change-me-in-production

# Token lifetime in hours (default: 24)
ACCESS_TOKEN_EXPIRE_HOURS=24

# LLM Narration (Module 9) — off by default
LLM_NARRATION_ENABLED=false

# ─── Admin portal credentials ─────────────────────────────────────────────────
# Username used to log into the /admin portal (not an email).
ADMIN_USERNAME=admin

# Bcrypt hash of the admin password. Generate with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
# NEVER store the plain password here.
ADMIN_PASSWORD_HASH=<generate-with-command-above>
